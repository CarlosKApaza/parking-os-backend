// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}


datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL") 
}

// Modelo de los 7 estacionamientos físicos

enum EstadoOcupacion {
  DESCONOCIDO
  LIBRE
  OCUPADO
}

model Estacionamiento {
  id            Int              @id @default(autoincrement())
  codigo        String           @unique
  sensorCodigo  String?          @unique
  estado        EstadoOcupacion  @default(DESCONOCIDO)
  activo        Boolean          @default(true)
  ultimaLectura DateTime?
  fechaCreacion DateTime         @default(now())
  fechaCambio   DateTime         @updatedAt

  eventos EventoEstacionamiento[]

  @@map("estacionamientos")
}



// Origen de los cambios de ocupación
enum OrigenEvento {
  SENSOR_IR
  SIMULACION
  ADMINISTRADOR
}

// Historial de cambios de los estacionamientos

model EventoEstacionamiento {
  id                Int             @id @default(autoincrement())
  estacionamientoId Int
  estadoAnterior    EstadoOcupacion
  estadoNuevo       EstadoOcupacion
  origen            OrigenEvento    @default(SENSOR_IR)
  fechaEvento       DateTime        @default(now())
  
  estacionamiento Estacionamiento @relation(fields: [estacionamientoId], references: [id])

  @@index([estacionamientoId, fechaEvento])
  @@map("eventos_estacionamiento")
}






// Una visita comienza al reconocer la placa en la entrada y termina al reconocerla
// en la salida. Los sensores IR registran ocupacion de plazas, independientemente.
model VisitaVehiculo {
  id            Int       @id @default(autoincrement())
  placa         String    @db.VarChar(12)
  // MySQL permite varios NULL en un indice UNIQUE; las visitas cerradas quedan en NULL.
  // Asi solo puede haber una visita abierta por placa, incluso con lecturas concurrentes.
  placaActiva   String?   @unique @db.VarChar(12)
  fechaIngreso  DateTime  @default(now())
  fechaSalida   DateTime?
  camaraIngreso String?   @db.VarChar(32)
  camaraSalida  String?   @db.VarChar(32)

  @@index([placa, fechaIngreso])
  @@map("visitas_vehiculos")
}


#DATABASE_URL="mysql://USUARIO:CONTRASEÑA@HOST:3306/NOMBRE_BD"
# Clave compartida SOLO entre la API NestJS y el lector Python, nunca en la PWA.
# Genera una con: py -c "import secrets; print(secrets.token_urlsafe(32))"
CAMERA_API_KEY=

# JWT_SECRET: clave aleatoria exclusiva de NestJS, mínimo 32 bytes.
JWT_SECRET=
# Solo entorno de feria: DEMO_SEED=1 habilita el seeder manual.
DEMO_SEED=0
# Opcional: crear administrador demo con contraseña distinta (mínimo 12 caracteres).
# DEMO_ADMIN_PASSWORD=

# Solo feria local: 1 permite reservar con una lectura LIBRE antigua. Por defecto 0.
RESERVAS_PERMITIR_LECTURA_ANTIGUA=0

# Solo feria local: habilita matrículas únicas sin acreditar propiedad real. Bloqueado en producción.
VEHICULOS_VERIFICACION_AUTOMATICA=0
